# === Trading Lab Dashboard — Configuration ===
# Copier ce fichier en .env et ajuster les valeurs

# Chemin absolu vers results/runs/ du trading-lab
RUNS_DIR=/Users/chedly/Mon\ Équipe/projets/Trading/files/initiaux/trading-lab/results/runs

# Dossier registre stratégies (relatif à la racine trading-dashboard/)
STRATEGY_REGISTRY_DIR=./strategies/registry

# Clé API Anthropic (optionnel — vue IA désactivée si absent)
ANTHROPIC_API_KEY=sk-ant-...

# Port backend (auto-détecté entre 8000 et 8100 si non défini)
# BACKEND_PORT=8000

# URL backend utilisée par le frontend Next.js
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
